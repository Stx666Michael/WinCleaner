<ui:FluentWindow x:Class="WinCleaner.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:WinCleaner.App"
                 Title="WinCleaner" Width="1120" Height="760" MinWidth="920" MinHeight="640"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Tertiary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="SortHeader" TargetType="TextBlock">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Own checkbox look: the stock one is clipped when used without a label inside list rows. -->
        <Style x:Key="RowCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="1"
                                Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                            <Path x:Name="Check" Data="M 0,5 L 4,9 L 11,0" Width="12" Height="10" Stretch="Uniform"
                                  Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WinCleaner" />

        <Grid Grid.Row="1">

            <!-- ============================== HOME ============================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Home}">
                <StackPanel MaxWidth="720" Margin="32,12,32,32" HorizontalAlignment="Center">
                    <TextBlock Text="Free up disk space" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,28"
                               Text="Scan to find junk and large files. Nothing is removed until you pick it and confirm." />

                    <TextBlock Text="Where to scan" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource RowCheckBox}" IsChecked="{Binding IsSelected}" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,6" />
                                            <TextBlock Text="{Binding UsageText}" FontSize="12" Style="{StaticResource Secondary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding CustomFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Folder24" FontSize="20" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" Margin="12,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ui:Button Grid.Column="2" Appearance="Transparent" ToolTip="Remove"
                                                   Icon="{ui:SymbolIcon Dismiss24}"
                                                   Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:Button Content="Add folder…" Icon="{ui:SymbolIcon FolderAdd24}" Margin="0,4,0,0"
                               Command="{Binding AddFolderCommand}" />

                    <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                        <TextBlock Text="Flag files larger than" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox ItemsSource="{Binding Thresholds}" SelectedItem="{Binding SelectedThreshold}"
                                  DisplayMemberPath="Label" MinWidth="120" />
                    </StackPanel>

                    <ui:Button Content="Scan" Appearance="Primary" Icon="{ui:SymbolIcon Search24}"
                               MinWidth="180" Height="42" Margin="0,28,0,0" HorizontalAlignment="Left"
                               Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ SCANNING ============================ -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720"
                        Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Scanning}">
                <ui:ProgressRing IsIndeterminate="True" Width="64" Height="64" />
                <TextBlock Text="Scanning…" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,8" />
                <TextBlock Text="{Binding ScanFound}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ScanStats}" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock Text="{Binding ScanCurrentFolder}" Style="{StaticResource Tertiary}" FontSize="12"
                           TextTrimming="CharacterEllipsis" MaxWidth="640" Margin="0,16,0,0" HorizontalAlignment="Center" />
                <ui:Button Content="Cancel" Margin="0,28,0,0" HorizontalAlignment="Center" MinWidth="120"
                           Command="{Binding CancelScanCommand}" />
            </StackPanel>

            <!-- ============================= RESULTS ============================ -->
            <Grid Margin="24,4,24,16"
                  Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Results}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Scan results" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="New scan" Icon="{ui:SymbolIcon ArrowSync24}"
                               VerticalAlignment="Center" Command="{Binding BackToHomeCommand}" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,8"
                        Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Secondary}">
                            <Run Text="{Binding DeniedFolders, Mode=OneWay}" />
                            <Run Text="folders could not be read. Restart as administrator to include them and the Windows cache items." />
                        </TextBlock>
                        <ui:Button Grid.Column="1" Content="Restart as administrator" Margin="12,0,0,0"
                                   Icon="{ui:SymbolIcon Shield24}" Command="{Binding RestartAsAdminCommand}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- categories -->
                    <Border Style="{StaticResource Card}" Padding="6">
                        <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                                         Fill="{Binding Tier, Converter={StaticResource TierBrush}}" />
                                                <TextBlock FontSize="12" Style="{StaticResource Secondary}">
                                                    <Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" items" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Top" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- items -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox PlaceholderText="Search by name or folder"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        Icon="{ui:SymbolIcon Search24}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                <ui:Button Content="Select safe items" Command="{Binding SelectSafeCommand}"
                                           ToolTip="Ticks the low-risk items (caches, temp files, crash data)" />
                                <ui:Button Content="Select all shown" Margin="8,0,0,0" Command="{Binding SelectVisibleCommand}" />
                                <ui:Button Content="Clear" Margin="8,0,0,0" Command="{Binding ClearSelectionCommand}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="12,0,26,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Name ⇅" Style="{StaticResource SortHeader}" HorizontalAlignment="Left"
                                       ToolTip="Sort by name">
                                <TextBlock.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding SortByCommand}" CommandParameter="Name" /></TextBlock.InputBindings>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="Size ⇅" Style="{StaticResource SortHeader}" HorizontalAlignment="Right"
                                       ToolTip="Sort by size">
                                <TextBlock.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding SortByCommand}" CommandParameter="Size" /></TextBlock.InputBindings>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Text="Modified ⇅" Style="{StaticResource SortHeader}" HorizontalAlignment="Center"
                                       ToolTip="Sort by date modified">
                                <TextBlock.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding SortByCommand}" CommandParameter="Modified" /></TextBlock.InputBindings>
                            </TextBlock>
                            <TextBlock Grid.Column="4" Text="Risk" FontSize="12" HorizontalAlignment="Center"
                                       Style="{StaticResource Secondary}" />
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <ListBox ItemsSource="{Binding ItemsView}" BorderThickness="0" Background="Transparent"
                                         HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource CompactRow}"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4" ToolTip="{Binding Finding.Path}">
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Open location" Command="{Binding OpenLocationCommand}" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource RowCheckBox}" Margin="8,0,0,0"
                                                          IsChecked="{Binding IsSelected}"
                                                          IsEnabled="{Binding IsLocked, Converter={StaticResource InvertBool}}" />
                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Reason}" FontSize="12" Style="{StaticResource Secondary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Folder}" FontSize="11" Style="{StaticResource Tertiary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Style="{StaticResource Secondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border Grid.Column="4" CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{Binding Tier, Converter={StaticResource TierBackground}}">
                                                    <TextBlock Text="{Binding TierText}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Tier, Converter={StaticResource TierBrush}}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Nothing to clean here. Your drives look tidy." HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Style="{StaticResource Secondary}"
                                           Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1" Content="Clean selected" Appearance="Primary" MinWidth="170" Height="38"
                                   Icon="{ui:SymbolIcon Delete24}" Command="{Binding RequestCleanCommand}"
                                   IsEnabled="{Binding HasSelection}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================= CLEANING =========================== -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520"
                        Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Cleaning}">
                <TextBlock Text="Cleaning…" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <ProgressBar Maximum="{Binding CleanTotal}" Value="{Binding CleanDone, Mode=OneWay}" Height="8" Margin="0,24,0,10" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Secondary}">
                    <Run Text="{Binding CleanDone, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding CleanTotal, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding CleanCurrent}" Style="{StaticResource Tertiary}" FontSize="12"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <ui:Button Content="Stop" Margin="0,24,0,0" HorizontalAlignment="Center" MinWidth="120"
                           Command="{Binding CancelCleanCommand}" />
            </StackPanel>

            <!-- ============================= SUMMARY ============================ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Summary}">
                <StackPanel MaxWidth="680" Margin="32,40,32,32" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="64" HorizontalAlignment="Center"
                                   Foreground="{x:Static local:TierBrushConverter.Safe}" />
                    <TextBlock Text="{Binding SummaryHeadline}" FontSize="30" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,6" />
                    <TextBlock Text="{Binding SummaryDetail}" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" />

                    <Border Style="{StaticResource Card}" Margin="0,28,0,0"
                            Visibility="{Binding SummaryHasFailures, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding FailuresTitle}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,8"
                                       Text="Files in use, protected, or changed since the scan are left untouched." />
                            <ItemsControl ItemsSource="{Binding Failures}" MaxHeight="220"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Secondary}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                        <ui:Button Content="Back to results" Appearance="Primary" MinWidth="150" Height="38"
                                   Command="{Binding BackToResultsCommand}" />
                        <ui:Button Content="Open log" Margin="10,0,0,0" Height="38" Command="{Binding OpenLogCommand}" />
                        <ui:Button Content="Done" Margin="10,0,0,0" Height="38" MinWidth="90" Command="{Binding BackToHomeCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ CONFIRM DIALOG ====================== -->
            <Grid Background="#99000000" Panel.ZIndex="10"
                  Visibility="{Binding ShowConfirm, Converter={StaticResource BoolToVis}}">
                <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="12" Padding="26"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding ConfirmTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />

                        <RadioButton GroupName="mode" Margin="0,18,0,0" MinWidth="0"
                                     IsChecked="{Binding PermanentDelete, Converter={StaticResource InvertBool}}"
                                     Content="Move to Recycle Bin (recommended)" />
                        <RadioButton GroupName="mode" Margin="0,4,0,0" MinWidth="0"
                                     IsChecked="{Binding PermanentDelete}"
                                     Content="Delete permanently" />

                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Visibility="{Binding PermanentDelete, Converter={StaticResource InvertBoolToVis}}"
                                   Text="You can restore these from the Recycle Bin. Disk space is only freed once the Recycle Bin is emptied." />
                        <TextBlock Foreground="{x:Static local:TierBrushConverter.Review}" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Visibility="{Binding PermanentDelete, Converter={StaticResource BoolToVis}}"
                                   Text="Permanently deleted files cannot be restored." />
                        <TextBlock Foreground="{x:Static local:TierBrushConverter.Review}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding ConfirmHasBin, Converter={StaticResource BoolToVis}}"
                                   Text="Emptying the Recycle Bin is always permanent." />
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding ConfirmHasReview, Converter={StaticResource BoolToVis}}">
                            <Run Text="{Binding ConfirmReviewCount, Mode=OneWay}" />
                            <Run Text="selected items are marked Review: files from your own folders. Make sure you do not need them." />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <ui:Button Content="Cancel" MinWidth="100" Command="{Binding CancelConfirmCommand}" />
                            <ui:Button Content="Clean" Appearance="Primary" MinWidth="100" Margin="10,0,0,0"
                                       Command="{Binding ConfirmCleanCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
