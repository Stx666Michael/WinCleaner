<Application x:Class="WinCleaner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:WinCleaner.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:InverseBoolConverter x:Key="InvertBool" />
            <local:InverseBoolToVisibilityConverter x:Key="InvertBoolToVis" />
            <local:StateToVisibilityConverter x:Key="StateToVis" />
            <local:TierBrushConverter x:Key="TierBrush" />
            <local:TierBackgroundConverter x:Key="TierBackground" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
